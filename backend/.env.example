# Copy to `.env` and fill in.  `.env` is gitignored and must never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=monparcours
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Optional override. Leave unset and the URL is assembled from the parts above
# (see app/core/config.py), which keeps the password in exactly one place.
# Set it only for a connection the parts cannot express — a socket path, SSL
# options, a managed-database URL.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
API_PORT=8000

# Comma-separated browser origins allowed to call the API.
# 5173 is the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# AI / Mistral
# ---------------------------------------------------------------------------
# This project uses the Mistral API — do not commit a real key.
MISTRAL_API_KEY=
FRAUD_VISION_ENDPOINT=http://127.0.0.1:8011/analyse
FRAUD_ENABLE_ELA=true
MISTRAL_MODEL=mistral-medium-latest

# Profiling assistant: keep false so every turn calls Mistral (Mistral-only).
# Set to true ONLY to run the assistant offline without a key (local dev, tests),
# which enables the deterministic rule-based fallback.
MISTRAL_ALLOW_FALLBACK=false

# ---------------------------------------------------------------------------
# France Travail — Offres d'emploi API (modules/ai/job_search)
# ---------------------------------------------------------------------------
# OAuth2 client_credentials app: register free at francetravail.io, create an
# application, associate the "Offres d'emploi" API to it. Real job listings
# only — without these, job search degrades to `available: false` rather
# than inventing offers.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Citizen AI Assistant (RAG APL) — optional
# ---------------------------------------------------------------------------
# The assistant uses MISTRAL_API_KEY above; everything below is optional.
#
# Semantic search (Qdrant + embeddings) is on by default. The timeout bounds how
# long STARTUP waits for it, not whether it is ever available: past the delay the
# assistant starts answering on BM25 alone, the build carries on in the
# background, and the pipeline switches itself to hybrid the moment it finishes
# (watch for "recherche sémantique disponible" in the log). Raising it only
# delays the port opening — loading torch plus the model takes ~35 s on Windows
# even with everything cached. CHATBOT_SEMANTIC=0 is the only setting that
# actually turns semantic search off (offline dev, tests).
# CHATBOT_SEMANTIC=1
# CHATBOT_SEMANTIC_TIMEOUT_S=25

# Startup: the engine (indexes + embeddings) is built before the port is served,
# which costs ~25 s. Set to 0 to skip it — the engine is then built, under lock,
# by the first question that needs it. Used by the test suite and quick dev loops.
# CHATBOT_WARMUP=1

# Hard ceiling on a single Mistral call. Without it, a hung connection pins a
# worker thread for as long as the network lets it.
# CHATBOT_LLM_TIMEOUT_S=25

# --- Spending and rate limits ----------------------------------------------
# `POST /api/citizen/chatbot/message` is public on purpose (a citizen must be
# able to ask without an account) and every turn costs money at Mistral. Two
# independent bounds protect it: a per-caller quota, and a global daily budget.
#
# ⚠️ THE DAILY BUDGET IS OFF UNLESS YOU SET IT. Empty or 0 means no circuit
# breaker at all: the per-caller quotas still apply, but a thousand legitimate
# callers cost a thousand times the quota and nothing stops them. Set a number of
# tokens per day (all callers and branches combined) and the assistant stops
# calling the model past it, answering "momentanément indisponible" instead.
# Watch `assistant.jetons_jour` on `GET /api/health` for a few days to pick it.
CHATBOT_BUDGET_JETONS_PAR_JOUR=

# ⚠️ MUST MATCH YOUR TOPOLOGY — it decides whose quota is whose.
#   0 behind a reverse proxy (Nginx, a load balancer, Cloudflare): every request
#     carries the PROXY's address, so all citizens share one bucket and lock each
#     other out.
#   1 with no proxy in front: anyone can send their own `X-Forwarded-For` and get
#     a fresh quota per request, which is the same as having no limit.
TRUST_PROXY_HEADERS=0

# Per-caller quotas. Anonymous callers are keyed by IP — a household, a campus or
# a library counts as one caller, hence a deliberately generous daily figure: it
# targets a script, not a family sharing a computer. Signed-in callers are keyed
# by account, a more reliable key, hence the wider allowance.
# CHATBOT_ANON_PAR_MINUTE=10
# CHATBOT_ANON_PAR_JOUR=100
# CHATBOT_AUTH_PAR_MINUTE=30
# CHATBOT_AUTH_PAR_JOUR=500

# LangSmith tracing of the assistant's LLM calls (which node, which prompt,
# which latency). Entirely inactive unless both variables are set.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=apl-rag

# ---------------------------------------------------------------------------
# Email delivery (verification + password reset)
# ---------------------------------------------------------------------------
# `console` writes messages to the log instead of sending them — no SMTP server
# and no secrets needed for local development. Copy the link out of the API
# terminal. `smtp` delivers for real using the values below.
EMAIL_BACKEND=console
EMAIL_FROM=MonParcours <ne-pas-repondre@monparcours.fr>

# Required only when EMAIL_BACKEND=smtp.
# SMTP_HOST=smtp.example.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Where emailed links point. The frontend renders the pages that redeem the
# token, so this is the Vite/production origin — never the API's.
FRONTEND_BASE_URL=http://localhost:5173

# Token lifetimes. A verification link tolerates a spam folder; a reset link is
# an account-takeover primitive and expires fast.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------

# Voice (STT/TTS/classifier)
# ---------------------------------------------------------------------------
# Vendor selection for STT only: 'mistral' (default) or 'whisper'
VOICE_VENDOR=mistral

# Mistral voice API (used when VOICE_VENDOR=mistral)
VOICE_API_KEY=
VOICE_BASE_URL=https://api.mistral.ai/v1
VOICE_STT_MODEL=voxtral-mini-latest
VOICE_TTS_MODEL=voxtral-mini-tts-latest
VOICE_TTS_VOICE=fr_marie_neutral

# Whisper API (used when VOICE_VENDOR=whisper)
OPENAI_API_KEY=
# VOICE_STT_MODEL=whisper-1  # only needed when VOICE_VENDOR=whisper; duplicating this key overrides the voxtral-mini-latest value above

# Optional NLC classifier (fallback intent resolver). Leave disabled unless used.
VOICE_NLC_ENABLED=false
VOICE_NLC_API_KEY=
VOICE_NLC_BASE_URL=https://api.mistral.ai/v1
VOICE_NLC_MODEL=small-latest

# Optional: used by the minimal voice gateway; safe to ignore if unused
ENABLE_DB=false

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (anti-bot)
# ---------------------------------------------------------------------------
# Leave empty in development — captcha verification is skipped when unset.
TURNSTILE_SECRET_KEY=
