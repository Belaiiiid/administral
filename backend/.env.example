# Copy to `.env` and fill in.  `.env` is gitignored and must never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=monparcours
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Optional override. Leave unset and the URL is assembled from the parts above
# (see app/core/config.py), which keeps the password in exactly one place.
# Set it only for a connection the parts cannot express — a socket path, SSL
# options, a managed-database URL.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
API_PORT=8000

# Comma-separated browser origins allowed to call the API.
# 5173 is the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# AI / Mistral
# ---------------------------------------------------------------------------
# This project uses the Mistral API only — it is the single LLM provider.
# Used by the coherence analyser (modules/ai/coherence) AND the citizen
# profiling assistant (features/citizen/profiling). Never commit a real key.
#
# Coherence degrades to "a_revoir" (to review) without a key. The profiling
# assistant, being Mistral-only, instead returns an error when the key is
# missing (see MISTRAL_ALLOW_FALLBACK below) — it never invents an answer.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Profiling assistant: keep false so every turn calls Mistral (Mistral-only).
# Set to true ONLY to run the assistant offline without a key (local dev, tests),
# which enables the deterministic rule-based fallback.
MISTRAL_ALLOW_FALLBACK=false

# ---------------------------------------------------------------------------
# France Travail — Offres d'emploi API (modules/ai/job_search)
# ---------------------------------------------------------------------------
# OAuth2 client_credentials app: register free at francetravail.io, create an
# application, associate the "Offres d'emploi" API to it. Real job listings
# only — without these, job search degrades to `available: false` rather
# than inventing offers.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Citizen AI Assistant (RAG APL) — optional
# ---------------------------------------------------------------------------
# The assistant uses MISTRAL_API_KEY above; everything below is optional.
#
# Semantic search (Qdrant + embeddings) is on by default and bounded: if the
# index is not ready in time — typically the first download of the embeddings
# model — the assistant starts on BM25 alone rather than blocking, and still
# answers with citations. Set CHATBOT_SEMANTIC=0 to skip it entirely (offline
# dev), or shorten the timeout when the model is already cached.
# CHATBOT_SEMANTIC=1
# CHATBOT_SEMANTIC_TIMEOUT_S=25

# LangSmith tracing of the assistant's LLM calls (which node, which prompt,
# which latency). Entirely inactive unless both variables are set.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=apl-rag

# ---------------------------------------------------------------------------
# Email delivery (verification + password reset)
# ---------------------------------------------------------------------------
# `console` writes messages to the log instead of sending them — no SMTP server
# and no secrets needed for local development. Copy the link out of the API
# terminal. `smtp` delivers for real using the values below.
EMAIL_BACKEND=console
EMAIL_FROM=MonParcours <ne-pas-repondre@monparcours.fr>

# Required only when EMAIL_BACKEND=smtp.
# SMTP_HOST=smtp.example.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Where emailed links point. The frontend renders the pages that redeem the
# token, so this is the Vite/production origin — never the API's.
FRONTEND_BASE_URL=http://localhost:5173

# Token lifetimes. A verification link tolerates a spam folder; a reset link is
# an account-takeover primitive and expires fast.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
