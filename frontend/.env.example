# Copy to `.env` and fill in.  `.env` is gitignored and must never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Leave empty to use the Vite dev-server proxy (default: /api → localhost:8000).
# Set only when the API is served from a different origin (e.g. staging).
# VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (anti-bot)
# ---------------------------------------------------------------------------
# Site key (public) — obtain from https://dash.cloudflare.com/turnstile
# Test key (always passes): 1x00000000000000000000AA
# Leave empty in development — the captcha widget will not render.
VITE_TURNSTILE_SITE_KEY=
